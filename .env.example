DJANGO_SECRET_KEY=gere-uma-chave-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ticketja
POSTGRES_TEST_DB=ticketja_test
POSTGRES_USER=ticketja_app
POSTGRES_PASSWORD=defina-a-senha-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Regras comerciais
ORDER_RESERVATION_MINUTES=15


# Armazenamento persistente das imagens em produção.
# Nunca coloque uma credencial verdadeira neste arquivo.
# Em desenvolvimento, deixe vazio para utilizar a pasta media.
CLOUDINARY_URL=


# E-mail temporário do ambiente demonstrativo.
# O backend console registra as mensagens somente nos logs privados.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TicketJá <nao-responda@ticketja.local>

# Administrador inicial do ambiente demonstrativo.
# As credenciais verdadeiras serão cadastradas somente no Render.
TICKETJA_ADMIN_EMAIL=admin@example.com
TICKETJA_ADMIN_PASSWORD=defina-uma-senha-longa-e-exclusiva

PAYMENT_GATEWAY_CLASS=apps.payments.gateways.mercado_pago.MercadoPagoGateway
# Legado: usado somente enquanto MARKETPLACE_PAYMENTS_ENABLED=false.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT_SECONDS=15
PAYMENT_PIX_EXPIRATION_MINUTES=30
PAYMENT_RECONCILIATION_MIN_INTERVAL_MINUTES=5
PAYMENT_SETTLED_RECONCILIATION_INTERVAL_HOURS=24
PAYMENT_RECONCILIATION_LOOKBACK_DAYS=180

# A conciliação deve ser agendada no provedor de hospedagem:
# python manage.py reconcile_payments --limit 100

# Chave secreta gerada ao configurar o Webhook no Mercado Pago.
# Nunca coloque a chave verdadeira neste arquivo.
# URL: https://SEU-DOMINIO/webhooks/mercado-pago/payments/
MERCADO_PAGO_WEBHOOK_SECRET=

# Limite de 64 KiB para o corpo da notificação.
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536

# Use true somente com credenciais de teste.
MERCADO_PAGO_TEST_MODE=false

# Marketplace. Mantenha desativado até concluir a homologação.
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_OAUTH_ENABLED=false
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://ticketja-mvp.onrender.com/painel/recebimentos/mercado-pago/retorno/

# Gere uma chave exclusiva com Fernet.generate_key().
# Para rotação: chave_nova,chave_anterior
MARKETPLACE_TOKEN_ENCRYPTION_KEYS=
MARKETPLACE_OAUTH_STATE_TTL_MINUTES=10
